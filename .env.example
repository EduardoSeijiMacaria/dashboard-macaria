# Copie este arquivo para .env e preencha os valores. Nunca versione o .env.
# GIT_TOKEN: token fine-grained do GitHub, somente leitura, com Issues (repositório) e Projects (organização).
GIT_TOKEN=
# REPOSITORY_URL: https://github.com/dono/repositorio ou dono/repositorio.
REPOSITORY_URL=
# PROJECT_NUMBER: número do Project da organização (o número que aparece na URL do Project). Deixe vazio para não consultar o Project.
PROJECT_NUMBER=
